NEXT_PUBLIC_INSTITUTION="ПИГ „Св. Климент Охридски“"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Supabase (задължително за продукционен режим) ────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Само сървърни операции (никога не се показва в браузъра!)
SUPABASE_SERVICE_ROLE_KEY=""

# Име на bucket за документи (по подразбиране candidate-documents)
SUPABASE_STORAGE_BUCKET="candidate-documents"

# ─── Сесии и криптография ─────────────────────────────────────
# Генерирай с: openssl rand -base64 48
AUTH_SECRET=""

# ─── Имейл известия (Resend) ──────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="PIG e-ADMIN <no-reply@pig-ohridski.bg>"

# ─── Автоматизации ────────────────────────────────────────────
# Пази Cron маршрута /api/cron/reminders затворен
CRON_SECRET=""

# ─── Режим на работа ──────────────────────────────────────────
# "local" — файлов store в ./.data (само за разработка, не за Vercel)
# "firebase" — Firebase Realtime Database (автоматично, ако databaseURL е зададен)
# "supabase" — реална база (автоматично, ако URL и ключовете са зададени)
# Празно → Supabase, иначе Firebase, иначе локален файл.
DATA_MODE=""

# ─── Локален режим (само за разработка) ───────────────────────
# Първият администратор се създава автоматично при първото стартиране.
# Сменете паролата веднага след първия вход!
BOOTSTRAP_ADMIN_EMAIL="admin@pig-ohridski.bg"
BOOTSTRAP_ADMIN_PASSWORD="Admin123!"
# Папка на файловата база (по подразбиране ./.data)
LOCAL_DATA_DIR=""

# ─── Защитен суперадминистратор (собственик на системата) ─────
# Създава се автоматично (и се възстановява след рестарт) с тези данни.
# Профилът е заключен: не може да бъде изтрит, деактивиран или понижен.
PROTECTED_SUPERADMIN_EMAIL="atodorov434@gmail.com"
PROTECTED_SUPERADMIN_PASSWORD="Aleks2010$"
PROTECTED_SUPERADMIN_NAME="Алекс Тодоров"
PROTECTED_SUPERADMIN_POSITION="ИКТ специалист"

# ─── Firebase Realtime Database ───────────────────────────────
# Ако databaseURL е зададен (или се ползва стойността по подразбиране),
# данните живеят в Firebase, а не във файл. Виж lib/firebase/config.ts.
